QATFAH_PORT=5059
QATFAH_DATA_DIR=/data
QATFAH_ADMIN_USER=admin
QATFAH_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
QATFAH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_CHARACTER_SECRET
QATFAH_WHATSAPP_ENABLED=false

# To enable secure Google Drive OAuth (server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api-domain.example/api/google/callback
# 32 random bytes, hex encoded (64 characters), NEVER commit a real value
QATFAH_GOOGLE_TOKEN_KEY=

# Optional official WhatsApp Business Cloud API per tenant (server-side only)
# QATFAH_WA_CLOUD_ACCOUNTS={"tenant-uuid":{"token":"...","phoneNumberId":"..."}}
QATFAH_WA_CLOUD_ACCOUNTS={}
